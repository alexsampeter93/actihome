<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.2.2.RELEASE</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>fp.project</groupId>
	<artifactId>actihome</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>actihome</name>
	<description>Demo project for Spring Boot</description>
	<properties>
		<java.version>11</java.version>
		<flatlaf.version>3.7.2</flatlaf.version>
		<miglayout.version>11.4.2</miglayout.version>
		<exec.mainClass>fp.project.actihome.ui.theme.ThemePreview</exec.mainClass>
	</properties>
	<dependencies>
		<!-- ==== Capa de presentación (rediseño de UI) ==== -->

		<!-- FlatLaf: Look and Feel moderno para Swing. Sustituye el aspecto "Metal"
			por defecto, soporta HiDPI y permite definir el tema en archivos .properties. -->
		<dependency>
			<groupId>com.formdev</groupId>
			<artifactId>flatlaf</artifactId>
			<version>${flatlaf.version}</version>
		</dependency>

		<!-- flatlaf-extras: aporta FlatSVGIcon (iconos vectoriales que escalan sin
			pixelarse y admiten recoloreado, necesario para teñirlos por estación). -->
		<dependency>
			<groupId>com.formdev</groupId>
			<artifactId>flatlaf-extras</artifactId>
			<version>${flatlaf.version}</version>
		</dependency>

		<!-- MigLayout: gestor de layout con el que se construyen las rejillas y el
			espaciado consistente del nuevo diseño (GridLayout/GridBagLayout no dan
			el control necesario). -->
		<dependency>
			<groupId>com.miglayout</groupId>
			<artifactId>miglayout-swing</artifactId>
			<version>${miglayout.version}</version>
		</dependency>

		<!-- ==== Núcleo de la aplicación ==== -->

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>

		<!-- Jackson: para leer la respuesta del servicio de traduccion (Fase 8.5).
			Sin version: la gestiona el BOM de Spring Boot, igual que el resto.

			Se anade una dependencia por UN campo de UNA respuesta, y aun asi es la
			decision correcta. La alternativa era extraerlo con una expresion regular, y
			ahi es donde se rompe: MyMemory devuelve el texto con escapes Unicode
			("café"), comillas escapadas y saltos de linea. Un parser a mano funciona
			con la primera respuesta que pruebas y falla con la primera resena que lleve
			una tilde, que en espanol es practicamente la primera. -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>

		<!-- Correo, para enviar el codigo de recuperacion por SMTP (Fase 8.6).

			Se usa el starter porque es la unica forma de que el BOM de Spring Boot
			gestione la version de JavaMail; el artefacto suelto no esta en el BOM. Del
			starter se usa SOLO la API de JavaMail: el JavaMailSender que autoconfigura
			no se inyecta en ninguna parte, porque su bean se crea lea o no la
			configuracion y entonces "estas configurado?" deja de tener respuesta clara,
			que es justo la pregunta de la que depende todo este flujo. Sin
			spring.mail.host esa autoconfiguracion ni siquiera se activa. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>

		<!-- H2: base de datos embebida, escrita en Java puro. Es la de por defecto:
			viaja dentro del jar y guarda los datos en un fichero del usuario, así que la
			aplicación se abre sin instalar ni configurar nada. -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- MySQL sigue disponible con el perfil "mysql", para trabajar contra un
			motor de servidor real cuando interese. -->
		<dependency>
			<groupId>mysql</groupId>
			<artifactId>mysql-connector-java</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!-- Herramientas de desarrollo del sistema de diseño, sin Spring ni base de
				datos. Es un plugin de construcción: no añade dependencias a la aplicación.

				Guía de estilo interactiva:
					mvnw compile exec:java
				Generar las capturas de las cuatro estaciones:
					mvnw compile exec:java -Dexec.mainClass=fp.project.actihome.ui.theme.ThemeSnapshots

				El main por defecto se declara como propiedad y no directamente en la
				configuración del plugin: la configuración del pom tiene prioridad sobre
				-D en la línea de comandos, así que escribirlo aquí impediría cambiarlo
				al invocar. Con la indirección, -D sí lo sobrescribe. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.5.0</version>
				<configuration>
					<mainClass>${exec.mainClass}</mainClass>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>